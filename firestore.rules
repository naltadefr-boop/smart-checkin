rules_version = '2';
// Règles de sécurité de la base Wellness Smart Check-in :
// seules les personnes connectées avec un compte créé par l'administrateur
// peuvent lire et écrire les fiches et les paramètres.
service cloud.firestore {
  match /databases/{database}/documents {
    match /fiches/{id} {
      allow read, write: if request.auth != null;
    }
    match /config/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
